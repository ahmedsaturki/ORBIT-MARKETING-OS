# Local runtime configuration
PORT=3000
# Keep localhost by default. Set 0.0.0.0 only when LAN mobile control is intentionally enabled.
RUNTIME_HOST=127.0.0.1
# Required when RUNTIME_HOST is a non-loopback address.
# Generate with a local password manager or: openssl rand -hex 32
RUNTIME_AUTH_TOKEN=
# Tauri desktop origins are trusted by default. Add explicit browser/LAN origins here when needed.
RUNTIME_ALLOWED_ORIGINS=
# Maximum requests per client address per rolling minute.
RUNTIME_RATE_LIMIT=120

# Resource-aware local AI defaults. Ollama is intentionally restricted to loopback HTTP.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_FAST_MODEL=llama3.2:3b
OLLAMA_REASONING_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=4096

# Optional: set this to a local multimodal Ollama model for image analysis.
OLLAMA_VISION_MODEL=
