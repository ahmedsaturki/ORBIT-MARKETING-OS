{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbit.local/schemas/rule-pack.schema.json",
  "title": "ORBIT Rule Pack",
  "type": "object",
  "required": ["id", "version", "platform", "capabilities", "selectors", "checksum"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "platform": {"enum": ["facebook", "instagram", "telegram", "whatsapp", "linkedin", "tiktok"]},
    "minAppVersion": {"type": "string"},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "selectors": {"type": "object", "additionalProperties": {"type": "string"}},
    "workflows": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object"}}},
    "checksum": {"type": "string", "minLength": 32}
  },
  "additionalProperties": false
}
