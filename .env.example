# Local runtime configuration
PORT=3000
# Keep localhost by default. Set 0.0.0.0 only when LAN mobile control is intentionally enabled.
RUNTIME_HOST=127.0.0.1
# Required when RUNTIME_HOST is a non-loopback address.
# Generate with a local password manager or: openssl rand -hex 32
RUNTIME_AUTH_TOKEN=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_FAST_MODEL=llama3.1:8b
OLLAMA_REASONING_MODEL=llama3.1:8b
# Optional: set this to a local multimodal Ollama model for image analysis.
OLLAMA_VISION_MODEL=
