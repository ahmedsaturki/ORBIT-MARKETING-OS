{
  "name": "orbit-marketing-os",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "verify:ipc": "node scripts/verify-ipc.mjs",
    "runtime:dev": "tsx server.ts",
    "runtime:start": "tsx server.ts",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:e2e": "playwright test",
    "verify:release": "node scripts/release-sanity.mjs",
    "test:performance": "pnpm exec tsx scripts/performance-smoke.mjs",
    "orbit": "tsx scripts/orbit-cli.ts",
    "orbit:mcp": "tsx scripts/orbit-mcp.ts",
    "test:surface": "node scripts/orbit-surface-smoke.mjs",
    "preflight:runner": "bash scripts/self-hosted-preflight.sh",
    "security:scan": "node scripts/security-scan.mjs",
    "soak": "pnpm exec tsx scripts/soak.ts",
    "mobile:typecheck": "pnpm --dir packages/mobile typecheck",
    "mobile:build": "pnpm --dir packages/mobile build",
    "tauri:build": "pnpm --dir packages/desktop tauri build",
    "verify:readiness": "node scripts/verify-release-readiness.mjs",
    "release:evidence": "node scripts/collect-release-evidence.mjs",
    "test:commercial-proof": "node scripts/commercial-connector-proof.safe.test.mjs",
    "test:soak:evidence": "node scripts/soak-failure-evidence.test.mjs",
    "triage:release": "node scripts/agent-release-triage.mjs",
    "verify:omp": "node scripts/verify-omp-contract.mjs",
    "benchmark:startup-memory": "node scripts/startup-memory-benchmark.mjs",
    "test:release-evidence-collector": "node scripts/release-evidence-collector-contract.test.mjs",
    "test:recovery:evidence": "node scripts/recovery-evidence.mjs",
    "verify:release-docs": "node scripts/verify-release-docs.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsx": "4.23.15",
    "turbo": "^2.5.6",
    "vite": "8.3.0"
  },
  "dependencies": {
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "lucide-react": "0.546.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "pnpm": {
    "overrides": {
      "query-string>decode-uri-component": "0.5.0",
      "xcode>uuid": "11.1.1"
    }
  }
}
