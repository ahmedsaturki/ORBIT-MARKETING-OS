{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORBIT Marketing OS",
  "version": "0.1.0",
  "identifier": "com.orbitmarketing.os",
  "build": {
    "beforeDevCommand": "pnpm --dir .. dev",
    "beforeBuildCommand": "pnpm --dir .. build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:11434"
    },
    "windows": [
      {
        "title": "ORBIT Marketing OS",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "appimage", "deb", "rpm"]
  }
}
