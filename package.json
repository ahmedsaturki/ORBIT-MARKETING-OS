{
  "name": "orbit-marketing-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "verify:ipc": "node scripts/verify-ipc.mjs && node scripts/verify-ipc-contract.test.mjs",
    "runtime:dev": "tsx server.ts",
    "runtime:start": "tsx server.ts",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:e2e": "playwright test",
    "verify:release": "node scripts/release-sanity.mjs",
    "test:performance": "pnpm exec tsx scripts/performance-smoke.mjs",
    "orbit": "tsx scripts/orbit-cli.ts",
    "orbit:mcp": "tsx scripts/orbit-mcp.ts",
    "test:surface": "node scripts/orbit-surface-smoke.mjs",
    "preflight:runner": "bash scripts/self-hosted-preflight.sh",
    "security:scan": "node scripts/security-scan.mjs",
    "soak": "pnpm exec tsx scripts/soak.ts",
    "mobile:typecheck": "pnpm --dir packages/mobile typecheck",
    "mobile:build": "pnpm --dir packages/mobile build",
    "tauri:build": "pnpm --dir packages/desktop tauri build",
    "build:icons": "node scripts/build-icon.mjs",
    "verify:readiness": "node scripts/verify-release-readiness.mjs",
    "release:evidence": "node scripts/collect-release-evidence.mjs",
    "test:commercial-proof": "node scripts/commercial-connector-proof.safe.test.mjs",
    "test:soak:evidence": "node scripts/soak-failure-evidence.test.mjs",
    "triage:release": "node scripts/agent-release-triage.mjs",
    "verify:omp": "node scripts/verify-omp-contract.mjs",
    "benchmark:startup-memory": "node scripts/startup-memory-benchmark.mjs",
    "test:release-evidence-collector": "node scripts/release-evidence-collector-contract.test.mjs",
    "test:recovery:evidence": "node scripts/recovery-evidence.mjs",
    "test:soak-runner-resilience": "node scripts/soak-runner-resilience.test.mjs",
    "test:security:scan": "node scripts/security-scan.test.mjs",
    "test:exec-trusted": "node --test scripts/lib/exec.test.mjs",
    "test:script-contracts": "node --test scripts/verify-workspace.test.mjs scripts/vercel-install.test.mjs scripts/build-all.test.mjs scripts/lib/spawn-pnpm.test.mjs && node scripts/verify-public-vercel-provenance.test.mjs",
    "verify:e2e-parses": "node scripts/verify-e2e-parses.mjs",
    "verify:release-docs": "node scripts/verify-release-docs.mjs",
    "verify:production-observation": "node scripts/verify-live-production-observation.mjs && node scripts/production-observation-contract.test.mjs",
    "test:node-forge-audit-exception": "node scripts/node-forge-audit-exception.test.mjs",
    "test:user-guide-contract": "node scripts/user-guide-contract.test.mjs",
    "test:braces-audit-exception": "node scripts/braces-audit-exception.test.mjs",
    "test:release-gate-model": "node scripts/release-gate-model.test.mjs",
    "test:release-gate-tooling": "node scripts/release-gate-tooling.test.mjs",
    "gate:check": "node scripts/check-release-gates.mjs",
    "gate:export": "node scripts/export-gate-status.mjs",
    "gate:dashboard": "node scripts/gate-dashboard.mjs",
    "test:health-model-availability": "node --import tsx scripts/health-model-availability.test.mjs",
    "test:gate-dashboard": "node scripts/gate-dashboard.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsx": "4.23.15",
    "turbo": "^2.11.6",
    "vite": "8.3.2"
  },
  "dependencies": {
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "lucide-react": "1.50.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
